// PitchCoach Ai × Athena Agentic - Prisma Schema
// Database: PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id          String  @id @default(cuid())
  clerkId     String  @unique // Clerk authentication ID
  email       String  @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?
  linkedinUrl String?

  // Onboarding
  country             String?
  primaryUseCase      String?
  onboardingCompleted Boolean @default(false)
  emailVerified       Boolean @default(false)

  // ── Device Tracking ────────────────────────────────────────────────────
  // Captured on first authenticated request after signup (signupDeviceId)
  // and refreshed on every subsequent /api/user/sync POST call (lastSignin*).
  // Used for security forensics, account recovery, and the "different device
  // = mail reauth" rule. deviceId is the SHA-256 hash of UA + Client Hints
  // (see src/lib/security.ts:getDeviceFingerprint).
  signupDeviceId      String?
  signupIp            String?
  signupUserAgent     String?
  signupAt            DateTime?
  lastSigninDeviceId  String?
  lastSigninIp        String?
  lastSigninUserAgent String?
  lastSigninAt        DateTime?

  // Subscription & Billing
  subscription Subscription?
  usage        Usage?

  // Coaching Data
  pitchDecks      PitchDeck[]
  pitchScripts    PitchScript[]
  pitchVideos     PitchVideo[]
  fullSessions    FullPitchSession[]
  founderSessions FounderSession[]

  // Chatbot
  chatMessages ChatMessage[]

  // Kal Protocol 2.0
  kalChatSessions KalChatSession[]

  // Athena agentic AI — sessions, messages, memory
  athenaSessions AthenaSession[]
  athenaMemories AthenaMemory[]

  // Job Queue — async AI analysis jobs owned by this user
  jobs Job[]

  // Timestamps
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastActiveAt DateTime?

  @@map("users")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plan Details
  plan   PlanType           @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Paystack Integration (African Markets)
  paystackCustomerId     String? // Paystack customer code
  paystackSubscriptionId String? // Paystack subscription code
  paystackPlanCode       String? // Paystack plan code

  // Stripe Integration (International)
  stripeCustomerId       String?   @unique // Stripe customer ID
  stripeSubscriptionId   String? // Stripe subscription ID
  stripePlanId           String? // Stripe price/plan ID
  stripePaymentMethodId  String? // Stripe payment method ID
  stripeCurrentPeriodEnd DateTime? // Stripe billing cycle end

  // Billing Cycle
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // Credits (for pay-per-use)
  creditsRemaining Int @default(0)
  creditsUsed      Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

enum PlanType {
  JJC
  INTERN
  COFOUNDER
  FOUNDER
  // Legacy aliases (for existing DB rows)
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
  TRIALING
}

model Usage {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Monthly Usage Tracking
  month DateTime @default(now()) // Track by month

  // Module Usage Counts
  e1DeckAnalyses        Int @default(0)
  e2ScriptCoachSessions Int @default(0)
  e3LivePitchSessions   Int @default(0)
  e4FullPitchSessions   Int @default(0)
  e5FounderSessions     Int @default(0)

  // AI Token Usage (for cost tracking)
  zaiTokensUsed Int @default(0) // Z.ai Gateway token usage

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usage")
}

// ============================================
// E1: PITCH DECK ANALYSER
// ============================================

model PitchDeck {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // File Info
  fileName   String
  fileUrl    String // WorkDrive storage URL
  fileSize   Int // in bytes
  fileType   String // pdf, pptx
  slideCount Int?

  // Analysis Results
  status AnalysisStatus @default(PENDING)

  // Content Scoring (0-100)
  problemClarityScore    Int?
  solutionClarityScore   Int?
  marketOpportunityScore Int?
  businessModelScore     Int?
  teamCredibilityScore   Int?
  tractionScore          Int?
  financialsScore        Int?
  askClarityScore        Int?
  overallScore           Int?

  // Visual Audit
  designConsistencyScore Int?
  readabilityScore       Int?
  visualHierarchyScore   Int?
  colorSchemeScore       Int?
  typographyScore        Int?

  // AI Feedback
  strengths       String[] // Array of strength points
  weaknesses      String[] // Array of improvement areas
  recommendations String[] // Actionable recommendations

  // Raw AI Response (for debugging/reprocessing)
  rawAnalysis Json?

  // User Notes
  notes String?

  // Iteration Tracking
  version      Int     @default(1)
  parentDeckId String? // For tracking iterations

  // Relations
  fullSessions    FullPitchSession[]
  founderSessions FounderSession[]

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  analyzedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([parentDeckId])
  @@map("pitch_decks")
}

// ============================================
// E2: ELEVATOR PITCH SCRIPT COACH
// ============================================

model PitchScript {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Input
  inputType    ScriptInputType // text, pdf, docx
  inputText    String? // Direct text input
  inputFileUrl String? // WorkDrive URL for uploaded file
  fileName     String?

  // Target Audience
  targetAudience String? // investor, customer, partner, etc.
  pitchDuration  Int? // Target duration in seconds

  // Analysis Results
  status AnalysisStatus @default(PENDING)

  // 5-Element Scoring (0-100)
  hookScore        Int? // Opening hook effectiveness
  problemScore     Int? // Problem articulation
  solutionScore    Int? // Solution clarity
  credibilityScore Int? // Team/traction credibility
  ctaScore         Int? // Call-to-action clarity
  overallScore     Int?

  // Script Metrics
  wordCount         Int?
  estimatedDuration Int? // in seconds

  // AI Feedback
  improvements     Json? // Structured improvement suggestions
  rewrittenScript  String? // AI-rewritten version
  alternativeHooks String[] // Alternative opening options

  // User Notes
  notes String?

  // Iteration Tracking
  version        Int     @default(1)
  parentScriptId String? // For tracking iterations

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  analyzedAt DateTime?

  @@index([userId])
  @@map("pitch_scripts")
}

enum ScriptInputType {
  TEXT
  PDF
  DOCX
}

// ============================================
// E3: LIVE ELEVATOR PITCH (VIDEO)
// ============================================

model PitchVideo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Video Info
  videoUrl     String // Video URL (WorkDrive or external)
  videoId      String // Video ID
  thumbnailUrl String?
  duration     Int // in seconds (max 180 for E3)
  fileSize     Int? // in bytes

  // File Storage
  fileName String?
  r2Key    String? // Legacy key field (now stores WorkDrive file ID)
  type     String? // 'LIVE' or 'FULL'

  // Analysis Results
  status AnalysisStatus @default(PENDING)

  // Delivery Scores (0-100)
  paceScore            Int? // Speaking pace appropriateness
  clarityScore         Int? // Speech clarity
  fillerWordScore      Int? // Filler word usage (lower = more fillers)
  energyScore          Int? // Energy and enthusiasm
  confidenceScore      Int? // Perceived confidence
  overallDeliveryScore Int?

  // Body Language Scores (0-100)
  eyeContactScore          Int?
  facialExpressionScore    Int?
  gestureScore             Int?
  postureScore             Int?
  overallBodyLanguageScore Int?

  // Metrics
  wordsPerMinute  Int?
  fillerWordCount Int?
  fillerWords     Json? // { "um": 5, "uh": 3, "like": 2 }

  // AI Feedback
  deliveryFeedback     String? // Detailed feedback on delivery
  bodyLanguageFeedback String? // Detailed feedback on body language
  keyMoments           Json? // Timestamps of notable moments

  // Transcript
  transcript               String? // Full transcript
  transcriptWithTimestamps Json? // Word-level timestamps

  // User Notes
  notes String? // Free-form notes (auto-save from session detail page)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  analyzedAt DateTime?

  @@index([userId])
  @@map("pitch_videos")
}

// ============================================
// E4: FULL PITCH SESSION (30-MIN VIDEO + DECK)
// ============================================

model FullPitchSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Associated Deck (optional)
  pitchDeckId String?
  pitchDeck   PitchDeck? @relation(fields: [pitchDeckId], references: [id])

  // Video Info
  videoUrl     String // Video URL (WorkDrive or external)
  videoId      String // Video ID
  thumbnailUrl String?
  duration     Int // in seconds (up to 1800 for E4)
  fileSize     Int?

  // Analysis Results
  status AnalysisStatus @default(PENDING)

  // 6-Dimension Investor Readiness Scores (0-100)
  problemSolutionFit     Int?
  marketOpportunity      Int?
  businessModelViability Int?
  teamCredibility        Int?
  tractionMilestones     Int?
  deliveryPresence       Int?
  overallReadinessScore  Int?

  // Investor Readiness Level
  investorReadinessLevel InvestorReadinessLevel?

  // Detailed Sub-Scores
  contentScores  Json? // Detailed content breakdown
  deliveryScores Json? // Detailed delivery breakdown

  // AI Feedback
  strengths          String[]
  weaknesses         String[]
  investorConcerns   String[] // Likely investor concerns
  recommendedActions String[] // Priority action items

  // Competitive Context
  competitiveAnalysis Json? // How this pitch compares

  // Q&A Preparation (AI-generated likely questions)
  anticipatedQuestions Json? // [{ question: "...", suggestedAnswer: "..." }]

  // Transcript
  transcript               String?
  transcriptWithTimestamps Json?

  // User Notes
  notes String?

  // Iteration Tracking
  version             Int     @default(1)
  parentFullSessionId String?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  analyzedAt DateTime?

  @@index([userId])
  @@map("full_pitch_sessions")
}

// ============================================
// E5: PITCH FOUNDER SESSIONS
// ============================================
// (See FounderSession model below, after InvestorReadinessLevel + FounderModuleType enums)

enum InvestorReadinessLevel {
  NOT_READY // 0-40
  NEEDS_WORK // 41-60
  INVESTOR_READY // 61-80
  HIGHLY_PREPARED // 81-100
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  KAL_PENDING
  KAL_FAILED
}

// ============================================
// E5: PITCH FOUNDER — Conversion Layer
// ============================================

enum FounderModuleType {
  FOUNDER_READINESS
  PATHWAY_RECOMMENDATION
  INVESTOR_RESEARCH
  COHORT_MATCHING
  NETWORK_PROFILE
  PATHWAY_NARRATION
}

model FounderSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Associated Deck (optional)
  pitchDeckId String?
  pitchDeck   PitchDeck? @relation(fields: [pitchDeckId], references: [id])

  // Module type
  moduleType FounderModuleType

  // Session status
  status AnalysisStatus @default(PENDING)

  // Input data (varies by module)
  inputData Json?

  // AI analysis results (structured JSON)
  resultData Json?

  // Key scores (0-100)
  overallScore Int?

  // Recommended pathway (for pathway modules)
  recommendedPathway String? // "GRIT_TO_GEAR" or "AFRIFLOW_DIRECT"

  // Audio narration (base64 WAV for TTS modules)
  audioBase64 String?

  // AI metadata
  modelUsed  String?
  tokensUsed Int?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  analyzedAt DateTime?

  @@index([userId])
  @@index([moduleType])
  @@index([status])
  @@map("founder_sessions")
}

// ============================================
// BILLING & TRANSACTIONS
// ============================================

model Transaction {
  id     String @id @default(cuid())
  userId String

  // Transaction Details
  type     TransactionType
  amount   Int // in smallest currency unit (cents, kobo, etc.)
  currency String          @default("usd")

  // Payment Provider
  provider PaymentProvider @default(PAYSTACK)

  // Provider References
  providerReference  String? // Provider transaction/subscription reference
  providerAccessCode String? // Provider access/verification code

  // Credits
  creditsAdded Int @default(0)

  // Module Access
  moduleAccess ModuleAccess?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([provider])
  @@index([provider, providerReference])
  @@map("transactions")
}

// ============================================
// JOB QUEUE — async AI analysis jobs with retries + dead-letter
// ============================================
// A generic job record for any background AI work (deck analysis, script
// check, live pitch, full session, founder coaching). The API route
// creates a Job row with status=PENDING, then either:
//   (a) processes synchronously and updates to COMPLETED/FAILED, OR
//   (b) enqueues to a queue (QStash / BullMQ) and a worker picks it up.
//
// Retries: attempts increments on each try. When attempts >= maxAttempts,
// the job is moved to deadLetterAt and status=DEAD_LETTER for manual review.

model Job {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What kind of job — determines which worker handler processes it
  type JobType

  // Link to the session row (PitchDeck.id, PitchScript.id, etc.)
  sessionType String? // "deck" | "script" | "live" | "full" | "founder"
  sessionId   String?

  // Job state
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)

  // Timing
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  deadLetterAt DateTime?

  // Error tracking
  lastError    String?
  lastErrorAt  DateTime?
  errorHistory Json? // array of { attempt, error, at } objects

  // Idempotency — prevents duplicate job creation for the same request
  idempotencyKey String? @unique

  // Payload — the input data for the job (JSON: file pathname, options, etc.)
  payload Json?

  // Result — the output data (JSON: scores, feedback, etc.)
  result Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type, status])
  @@index([deadLetterAt])
  @@map("jobs")
}

enum JobType {
  DECK_ANALYSIS
  SCRIPT_CHECK
  LIVE_PITCH
  FULL_SESSION
  FOUNDER_COACHING
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

// ============================================
// PROCESSED WEBHOOK — idempotency for Stripe / Paystack / Clerk webhooks
// ============================================
// When a webhook arrives, we store its event ID here BEFORE processing.
// If the same event ID arrives again (Stripe/Paystack retry), we skip
// processing and return 200 OK (so the provider stops retrying).

model ProcessedWebhook {
  id        String          @id @default(cuid())
  provider  WebhookProvider
  eventId   String // Stripe event.id, Paystack reference, Clerk svix-id
  eventType String? // checkout.session.completed, user.created, etc.
  userId    String? // affected user (if known)

  // Result of processing
  processed    Boolean @default(true)
  errorMessage String?

  // Raw payload (truncated to 10KB for forensics)
  payload Json?

  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
  @@map("processed_webhooks")
}

enum WebhookProvider {
  STRIPE
  PAYSTACK
  CLERK
}

// ============================================
// WEBHOOK LOGGING
// ============================================

model WebhookLog {
  id     String  @id @default(cuid())
  userId String?

  // Session reference
  sessionId   String?
  sessionType String? // deck, script, live, full

  // Execution results
  success                   Boolean  @default(false)
  crmSynced                 Boolean  @default(false)
  emailSent                 Boolean  @default(false)
  entitlementUpdated        Boolean  @default(false)
  externalWebhooksTriggered Boolean  @default(false)
  errors                    String[]

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("webhook_logs")
}

enum TransactionType {
  SUBSCRIPTION
  ONE_TIME
  CREDIT_PURCHASE
  REFUND
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
}

model ModuleAccess {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Which modules are unlocked
  e1Access Boolean @default(false)
  e2Access Boolean @default(false)
  e3Access Boolean @default(false)
  e4Access Boolean @default(false)
  e5Access Boolean @default(false)

  // Usage limits
  e1Limit Int?
  e2Limit Int?
  e3Limit Int?
  e4Limit Int?
  e5Limit Int?

  // Current usage
  e1Used Int @default(0)
  e2Used Int @default(0)
  e3Used Int @default(0)
  e4Used Int @default(0)
  e5Used Int @default(0)

  // Expiry
  expiresAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())

  @@map("module_access")
}

// ============================================
// CHATBOT MESSAGES
// ============================================

model ChatMessage {
  id             String @id @default(cuid())
  userId         String
  conversationId String

  // Message content
  role    ChatRole
  content String

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}

// ============================================
// KAL PROTOCOL 2.0 — CHAT SESSIONS
// ============================================

model KalChatSession {
  id              String @id @default(cuid())
  userId          String
  scriptSessionId String // Links to PitchScript or other module session
  module          String // e1, e2, e3, e4, e5

  // Session state
  status String @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED

  // Chat messages (stored as JSON array of KalChatMessage)
  messages Json

  // Original input summary (first 500 chars of the pitch)
  inputSummary String?

  // Generated summary after all 10 questions answered
  summary       String?
  quickFeedback String?
  finalDecision String? // SUCCESS, FAILURE, PENDING

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scriptSessionId])
  @@index([status])
  @@map("kal_chat_sessions")
}

// ============================================
// SECURITY — BLOCKED IPs / DEVICES & INCIDENT LOG
// ============================================
// Tracks every denied access attempt (blocked email, blocked IP, geo-block, etc.)
// and the persistent blocklist of IPs/devices that have been permanently banned.
model SecurityIncident {
  id        String   @id @default(cuid())
  email     String? // Email used in attempt (if known)
  ip        String // IP address of attempt
  deviceId  String // SHA-256 fingerprint of request headers
  userAgent String? // Full User-Agent string (for forensic analysis)
  reason    String // BLOCKED_EMAIL | BLOCKED_IP | GEO_BLOCK | SCRAPER | DIRECT_ASSET_ACCESS
  pathname  String? // Path that triggered the incident
  country   String? // Geo country code (if known via x-vercel-ip-country)
  metadata  Json? // Additional context (e.g. which rule matched)
  blocked   Boolean  @default(false) // Whether this incident resulted in a permanent block
  createdAt DateTime @default(now())

  @@index([ip])
  @@index([deviceId])
  @@index([email])
  @@index([reason])
  @@index([createdAt])
  @@map("security_incidents")
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique // IP address to block
  deviceId  String? // Optional: device fingerprint hash
  email     String? // Email that triggered the block (if applicable)
  reason    String // Why blocked (BLOCKED_EMAIL, SCRAPER, ATTACK, etc.)
  attempts  Int      @default(1)
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  permanent Boolean  @default(true)

  @@index([deviceId])
  @@index([email])
  @@map("blocked_ips")
}

// ============================================
// ATHENA AGENTIC AI — MEMORY & ADAPTIVE LEARNING LAYER
// ============================================
// Houses Athena's persistent memory: sessions, individual messages, and
// extracted long-term memory entries (preferences, facts, corrections).
//
// ARCHITECTURE:
//   - Sessions are created when a user starts a conversation with Athena.
//   - Each message (user, assistant, tool) is logged to athena_messages.
//   - The 36-hour refresh cron (workers/athena-memory-cron/) summarizes
//     sessions older than 36 hours into compact athena_memory entries
//     (kind: preference | fact | skill | correction | intent), then
//     archives the raw messages.
//   - On every Athena invocation, athena_memory is queried for active
//     (non-archived, non-expired) entries for this user, which are
//     injected into the system prompt as context.
//   - Memory entries auto-expire after 36 hours unless refreshed by
//     a new session that touches the same topic.

model AthenaSession {
  id            String    @id @default(cuid())
  userId        String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  lastMessageAt DateTime?
  summary       String?   // Auto-generated by the 36hr cron, ≤500 chars
  messageCount  Int       @default(0)
  tokensUsed    Int       @default(0)
  modelUsed     String?
  status        String    @default("active") // active | closed | archived
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AthenaMessage[]
  memories AthenaMemory[]

  @@index([userId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("athena_sessions")
}

model AthenaMessage {
  id         String   @id @default(cuid())
  sessionId  String
  role       String   // user | assistant | tool | system
  content    String
  toolCalls  Json?    // [{name, args, result}]
  tokensIn    Int?
  tokensOut   Int?
  model      String?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  // Relations
  session AthenaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("athena_messages")
}

model AthenaMemory {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String?
  kind          String   // preference | fact | skill | correction | intent
  content       String
  confidence    Float    @default(1.0)
  timesRecalled Int      @default(0)
  lastRecalledAt DateTime?
  createdAt     DateTime @default(now())
  expiresAt     DateTime @default(now()) // 36 hours from createdAt by default
  archived      Boolean  @default(false)

  // Relations
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AthenaSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, archived, expiresAt])
  @@index([kind])
  @@index([sessionId])
  @@map("athena_memory")
}

// ============================================
// ATHENA PERSONALITY — stored in DB, editable without redeploy
// ============================================
// "Her full personality and ability are housed in the database layer now."
// Multiple personality profiles can coexist (default, founder-mode, etc.).
// The active profile is selected by `enabled = true` (only one at a time).

model AthenaPersonality {
  id              String   @id @default(cuid())
  name            String   @unique // e.g. "default", "founder-mode"
  systemPrompt    String   // Injected into every Athena chat completion
  voiceId         String?  // TTS voice identifier (provider-specific)
  reasoningEffort String   @default("high") // low | medium | high | maximum
  maxTokens       Int      @default(8192)
  temperature     Float    @default(0.7)
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
