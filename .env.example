# ============================================
# PitchCoach Ai × Athena Agentic — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# Deployment checklist:
#   - Vercel: Add all variables in Project Settings → Environment Variables
#   - Self-host: Add to your .env file or hosting dashboard

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=https://pitchcoachai.tech
NODE_ENV=production

# ============================================
# DATABASE (PostgreSQL / Supabase)
# ============================================
# Pooled connection for serverless (via Prisma)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=20&sslmode=require
# Direct connection for migrations (required by Prisma)
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================
# SUPABASE
# ============================================
# Supabase project URL (used for REST API handshake and client-side SDK)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon/public key (safe for client-side, used for REST API handshake)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase service role key (server-side only, full admin access — NEVER expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# CLERK AUTHENTICATION
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# AI / Z.AI GATEWAY
# ============================================
# REQUIRED — Your API Key from the Z.ai platform
ZAI_API_KEY=your_zai_api_key
# Gateway URL — Z.ai API endpoint (https://api.z.ai/api/paas/v4)
# Both text and vision use the SAME /chat/completions endpoint.
# Vision is differentiated by model name (glm-4.5v, glm-5v-turbo) + image content.
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# REQUIRED — X-Token for gateway authentication (usually same as API key)
ZAI_TOKEN=your_zai_token
# OPTIONAL — Your API ID from the Z.ai platform (maps to userId)
ZAI_USER_ID=
# OPTIONAL — Chat session ID for session continuity
ZAI_CHAT_ID=

# ============================================
# PAYSTACK (South Africa / African Markets)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# STRIPE (International)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_SCRIPT=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MASTER=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# SUPABASE ACCESS TOKEN (for Athena MCP)
# ============================================
# Personal access token from supabase.com/dashboard/account/tokens
# Used by src/lib/athena-mcp.ts to connect to the Supabase MCP server.
# This is SEPARATE from the database connection — it's an API token for the
# Supabase MCP integration that powers Athena's db_query tool.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CLOUDFLARE R2 (Primary File Storage)
# ============================================
# S3-compatible object storage. Files are stored privately in R2 and only
# accessible via the /api/blob/download proxy route (enforces auth + ownership).
# Get credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=pitch-perfect

# ============================================
# SMTP (Transactional Email via Supabase SMTP relay)
# ============================================
# Used by src/lib/email.ts (nodemailer) for transactional + onboarding emails.
# Get credentials: Supabase Dashboard → Project → Authentication → Email Templates → SMTP Settings.
SMTP_HOST=smtp.supabase.com
SMTP_PORT=587
SMTP_USER=your_supabase_smtp_username
SMTP_PASS=your_supabase_smtp_password
SMTP_FROM_EMAIL=onboarding@pitchcoachai.tech
SMTP_FROM_NAME=PitchCoach Ai

# ============================================
# KAL ADAPTIVE AGENT (E2 Script Analysis Fallback)
# ============================================
# Strategy 2 fallback for E2 Script Check when Z.ai (primary) fails.
# Invoked directly from src/lib/ai-service.ts:analyzeWithKalAgent().
KAL_AGENT_URL=https://your-kal-agent.on.adaptive.ai
KAL_API_KEY=your-kal-api-key

# ============================================
# ATHENA UNION ALPHA WORKER (Deck Analysis Sidecar)
# ============================================
# Optional Cloudflare Worker deployed separately at
# https://athena-union-alpha-worker.morphylee22.workers.dev
# Fires non-blocking sidecar request during E1 (deck analysis) — failures
# never block the existing analysis pipeline.
# Source for this Worker is NOT in this repo — it's deployed independently.
ATHENA_UNION_ALPHA_WORKER_URL=https://athena-union-alpha-worker.morphylee22.workers.dev
UNION_ALPHA_ENABLED=false
# HMAC secret used to sign X-Athena-Auth tokens sent to the Worker.
# Must match the verifier secret configured on the Worker side.
WORKER_AUTH_SECRET=your-strong-random-hmac-secret

# ============================================
# DEVELOPMENT
# ============================================
DEVELOPER_EMAILS=dev1@example.com,dev2@example.com

# ============================================
# UPSTASH REDIS (Rate Limiting)
# ============================================
# Required for production rate limiting. If not set, rate limiting
# degrades to per-request mode (no state, permissive).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ============================================
# HEALTH CHECK (Internal monitoring)
# ============================================
# Secret token required to access full diagnostic data at /api/health?full=true
# If not set, the full health check returns a minimal auth-required response.
HEALTH_CHECK_SECRET=your-health-check-secret-token
