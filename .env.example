# ============================================
# PitchCoach Ai × Athena Agentic — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
NEXT_PUBLIC_APP_URL=https://pitchcoachai.tech
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=20&sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_TOKEN=your_zai_token

# Athena runtime, MCP authorization, and Cloudflare Workers AI.
# ATHENA_INTERNAL_SECRET must match the Worker secret and must remain server-side.
ATHENA_INTERNAL_SECRET=replace-with-a-long-random-secret
ATHENA_ALLOWED_MCP_TOOLS=web_search
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
# Accepted aliases; set only the names used by your deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_API_TOKEN=
ADAPTIVE_API_KEY=
KAL_API_KEY=your-kal-api-key

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_SCRIPT=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MASTER=price_xxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ORG_ID=your_org_id
ZOHO_SENDER_EMAIL=your-zoho-sender@example.com
ZOHO_WORKDRIVE_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
KAL_AGENT_URL=https://your-kal-agent.on.adaptive.ai
KAL_MIDDLEWARE_URL=https://your-kal-middleware.adaptive.ai
DEVELOPER_EMAILS=dev1@example.com,dev2@example.com
HEALTH_CHECK_SECRET=your-health-check-secret-token
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
