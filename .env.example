# ============================================
# Pitch Perfect × Automagikal — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# Deployment checklist:
#   - Vercel: Add all variables in Project Settings → Environment Variables
#   - Self-host: Add to your .env file or hosting dashboard

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=https://pitchperfect.ai
NODE_ENV=production

# ============================================
# DATABASE (PostgreSQL / Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================
# CLERK AUTHENTICATION
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# AI / Z.AI GATEWAY
# ============================================
# REQUIRED — Your API Key from the Z.ai platform
ZAI_API_KEY=your_zai_api_key
# Gateway URL (default is correct)
ZAI_BASE_URL=https://zukijufuzu.xyz/api/v1
# OPTIONAL — Your API ID from the Z.ai platform (maps to userId)
ZAI_USER_ID=
# OPTIONAL — Not needed for most setups (secondary X-Token auth)
ZAI_CHAT_ID=
ZAI_TOKEN=

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# PAYSTACK (South Africa / African Markets)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# STRIPE (International)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_SCRIPT=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MASTER=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# LEMONSQUEEZY (Merchant of Record)
# ============================================
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret
LEMONSQUEEZY_VARIANT_PITCH_DECK=your_variant_id
LEMONSQUEEZY_VARIANT_ELEVATOR_SCRIPT=your_variant_id
LEMONSQUEEZY_VARIANT_ELEVATOR_LIVE=your_variant_id
LEMONSQUEEZY_VARIANT_PITCH_DECK_LIVE=your_variant_id
LEMONSQUEEZY_VARIANT_MASTER=your_variant_id

# ============================================
# ZOHO BILLING (Enterprise)
# ============================================
ZOHO_BILLING_AUTH_TOKEN=your_zoho_billing_authtoken
ZOHO_BILLING_ORG_ID=your_org_id
ZOHO_BILLING_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# ZOHO CRM
# ============================================
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ORG_ID=your_org_id

# ============================================
# ZOHO WORKDRIVE (File Storage)
# ============================================
ZOHO_WORKDRIVE_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_FOLDER_ID=your_folder_id

# ============================================
# ZOHO FORMS (Contact Form)
# ============================================
ZOHO_FORMS_API_DOMAIN=https://forms.zoho.com
ZOHO_CONTACT_FORM_LINK_NAME=contact-form
ZOHO_FORMS_ACCESS_TOKEN=your_zoho_forms_token

# ============================================
# DEVELOPMENT
# ============================================
DEVELOPER_EMAILS=helloautomagikal@gmail.com,morphylee22@gmail.com
