# ============================================
# Pitch Perfect × Automagikal — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# Deployment checklist:
#   - Vercel: Add all variables in Project Settings → Environment Variables
#   - Self-host: Add to your .env file or hosting dashboard

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=https://pitchcoachai.tech
NODE_ENV=production

# ============================================
# DATABASE (PostgreSQL / Supabase)
# ============================================
# Pooled connection for serverless (via Prisma)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=20&sslmode=require
# Direct connection for migrations (required by Prisma)
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================
# SUPABASE
# ============================================
# Supabase project URL (used for REST API handshake and client-side SDK)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon/public key (safe for client-side, used for REST API handshake)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase service role key (server-side only, full admin access — NEVER expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# CLERK AUTHENTICATION
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# AI / Z.AI GATEWAY
# ============================================
# REQUIRED — Your API Key from the Z.ai platform
ZAI_API_KEY=your_zai_api_key
# Gateway URL (default is correct)
ZAI_BASE_URL=https://z.ai/model-api
# REQUIRED — X-Token for gateway authentication (usually same as API key)
ZAI_TOKEN=your_zai_token
# OPTIONAL — Your API ID from the Z.ai platform (maps to userId)
ZAI_USER_ID=
# OPTIONAL — Chat session ID for session continuity
ZAI_CHAT_ID=

# ============================================
# PAYSTACK (South Africa / African Markets)
# ============================================
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# STRIPE (International)
# ============================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_SCRIPT=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ELEVATOR_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PITCH_DECK_LIVE=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MASTER=price_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# ZOHO CRM
# ============================================
ZOHO_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ORG_ID=your_org_id
# Sender email address for Zoho CRM SendMail API (must be a verified Zoho user)
ZOHO_SENDER_EMAIL=akanimohdavid@yahoo.com

# ============================================
# ZOHO WORKDRIVE (Secondary File Storage)
# ============================================
# Optional — if not configured, Vercel Blob is used exclusively.
# Zoho WorkDrive serves as a secondary storage backend with
# graceful fallback to Vercel Blob when unavailable.
ZOHO_WORKDRIVE_CLIENT_ID=1000.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKDRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# KAL ADAPTIVE AGENT (PRIMARY — authenticated)
# ============================================
# The authenticated Kal Agent service — used for Kal Protocol 2.0 chat.
# When set, takes priority over KAL_MIDDLEWARE_URL.
# Requires KAL_API_KEY for authentication.
KAL_AGENT_URL=https://kal-agent-morpheos255918280.on.adaptive.ai
KAL_API_KEY=your-kal-api-key

# ============================================
# KAL ADAPTIVE MIDDLEWARE (LEGACY FALLBACK)
# ============================================
# Only used if KAL_AGENT_URL is not configured.
KAL_MIDDLEWARE_URL=https://kal-middleware-morpheos255918280.adaptive.ai

# ============================================
# DEVELOPMENT
# ============================================
DEVELOPER_EMAILS=helloautomagikal@gmail.com,morphylee22@gmail.com

# ============================================
# HEALTH CHECK (Internal monitoring)
# ============================================
# Secret token required to access full diagnostic data at /api/health?full=true
# If not set, the full health check returns a minimal auth-required response.
HEALTH_CHECK_SECRET=your-health-check-secret-token

# ============================================
# UPSTASH REDIS (Rate Limiting)
# ============================================
# Required for production rate limiting. If not set, rate limiting
# degrades to per-request mode (no state, permissive).
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ============================================
# GOOGLE AI / GEMINI (PRIMARY for E2 Script Check)
# ============================================
# Google Generative AI API for script analysis. This is the PRIMARY AI
# strategy for the E2 Script Check module (elevator pitch script coaching).
# The Z.ai gateway serves as fallback if Google AI is unavailable.
#
# REQUIRED: GOOGLE_GENAI_API_KEY (the only mandatory variable)
# OPTIONAL: GOOGLE_CLOUD_PROJECT (only needed for Vertex AI endpoint variant)
#
# HOW TO GET THE API KEY:
#   Option A (easiest): Google AI Studio
#     1. Go to https://aistudio.google.com/apikey
#     2. Sign in with your Google account
#     3. Click "Create API Key" or use an existing one
#     4. Copy the API key and set GOOGLE_GENAI_API_KEY below
#
#   Option B: Google Cloud Console
#     1. Go to https://console.cloud.google.com/
#     2. Enable the "Generative Language API" in APIs & Services
#     3. APIs & Services → Credentials → Create Credentials → API Key
#     4. Restrict the key to "Generative Language API"
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================
# VERCEL BLOB (File Storage)
# ============================================
# Required for client-side and server-side blob uploads.
# Automatically configured on Vercel — set manually for local dev.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# ============================================
# RESEND (Email Fallback)
# ============================================
# Resend is used as a fallback when Zoho CRM SendMail fails (OAuth issues,
# API outages, etc.). This ensures onboarding and transactional emails are
# never silently dropped.
#
# The "from" address in Resend is set to onboarding@pitchcoachai.tech.
# Make sure the domain is verified in your Resend dashboard.
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
